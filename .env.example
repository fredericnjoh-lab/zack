# Optional — for real Instagram scrape + richer scripts
APIFY_TOKEN=
# Prefer Claude (Anthropic). OpenAI is fallback only.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias accepted
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# PORT=8787   # Zack uniquement — laisse vide, sinon les outils tools/ se battent pour ce port

# --- Outils tools/ (agence, leads, builder) ---
# Ils réutilisent APIFY_TOKEN et ANTHROPIC_API_KEY ci-dessus.
# Passerelles optionnelles, à laisser vides dans 99% des cas :
# ANTHROPIC_BASE_URL=
# APIFY_BASE_URL=
# Robot Apify utilisé par l'outil leads :
# APIFY_MAPS_ACTOR=compass~crawler-google-places
# Chaque outil a son port (8801 / 8802 / 8803 par défaut) :
# PORT_AGENCE=8801
# PORT_LEADS=8802
# PORT_BUILDER=8803
