# Optional — for real Instagram scrape + richer scripts
APIFY_TOKEN=
# Prefer Claude (Anthropic). OpenAI is fallback only.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias accepted
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
PORT=8787

# Repost Instagram → YouTube
# Google Cloud → APIs & Services → OAuth client (type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rempli automatiquement après « Connecter YouTube » — à recopier ici pour
# survivre à un redéploiement (le disque Render free est éphémère).
GOOGLE_REFRESH_TOKEN=
# Doit correspondre EXACTEMENT à l'URI autorisée côté Google Cloud.
# Par défaut : https://<ton-domaine>/api/youtube/callback
YOUTUBE_REDIRECT_URI=
# Compte Instagram source + chaîne YouTube cible (valeurs par défaut de l'app)
IG_SOURCE_HANDLE=fredjoclothing.paris
YOUTUBE_HANDLE=fredjoclothing
# private | unlisted | public — visibilité des vidéos publiées
YOUTUBE_PRIVACY=private
