# Optional — for real Instagram scrape + richer scripts
APIFY_TOKEN=
# Prefer Claude (Anthropic). OpenAI is fallback only.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=   # alias accepted
# ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
# Optional but recommended on Render Free: durable snapshot of every search and setting.
# Create a free Redis database at https://console.upstash.com, then copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional when several Zack instances share one Redis database.
ZACK_STORE_KEY=zack:store
PORT=8787
